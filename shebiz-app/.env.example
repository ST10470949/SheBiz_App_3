# SheBiz settings. Copy this file to a new file named exactly ".env" and fill in the values.
# No quotes, no spaces around "=". Restart "npm run dev" after every change.
# Never share or upload your real .env file.

# --- Firebase (required) ---
# Firebase Console > Project settings > General > Your apps > Web app > firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Which setup are you using? ---
# false = FREE (Spark plan): Firebase emails a verification LINK, AI runs from the browser.
# true  = PAID (Blaze plan): 6-digit email codes and AI through Cloud Functions (see README).
VITE_USE_CLOUD_FUNCTIONS=false

# --- AI assistant, free setup only ---
# Free key from https://aistudio.google.com (Get API key). It is visible in the website's code,
# so restrict it to your site's address in Google Cloud > APIs & Services > Credentials.
# Leave empty if VITE_USE_CLOUD_FUNCTIONS=true.
VITE_GEMINI_API_KEY=